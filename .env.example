# Copy to .env (git-ignored) and fill in what you use. Nothing here is required
# for the tests; a dry run needs no keys at all.

# Letter writer and reviewer
LLM_PROVIDER=anthropic
# anthropic default: claude-sonnet-5. The openai provider needs a model name here.
LLM_MODEL=
ANTHROPIC_API_KEY=
# openai provider only: any OpenAI-compatible Chat Completions endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_TOKENS=

# Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FIRECRAWL_API_KEY=

# Tracker (Supabase, table from migrations/)
SUPABASE_URL=
SUPABASE_KEY=

# Telegram digest and follow-up drafts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# scripts/mailcheck.py only (read-only IMAP)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
